<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DiffSync.Native</RootNamespace>
    <AssemblyName>DiffSync.Native</AssemblyName>
    <Description>Managed binding of the diffsync C ABI (diffsync_core.dll).</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS0649;CS0169</NoWarn>
    <!-- the DLL to copy next to the assembly: -p:DiffSyncDll=... or the debug build by default -->
    <DiffSyncDll Condition="'$(DiffSyncDll)' == ''">$(MSBuildThisFileDirectory)..\..\..\target\debug\diffsync_core.dll</DiffSyncDll>
  </PropertyGroup>
  <ItemGroup>
    <!-- generated by `cargo xtask bindings`; never edited -->
    <Compile Include="..\NativeMethods.g.cs" Link="NativeMethods.g.cs" />
    <None Include="$(DiffSyncDll)" Condition="Exists('$(DiffSyncDll)')" Link="diffsync_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
